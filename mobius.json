{
  "id": "maak",
  "name": "MAAK",
  "version": "1.0.0-mobius.1",
  "description": "Moj glas, moj izbor. Bosanska komunikacijska tabla s 95 originalnih simbola i zasebnim Möbius Voice demom.",
  "author": "Eldar Ćerim / PONTEM",
  "license": "MIT",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": false,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "capabilities": {
    "device.storage": {
      "version": 1,
      "reason": "Sačuvati tablu, vlastite slike i odabrane audio datoteke samo na ovom uređaju, bez slanja serveru.",
      "limits": {
        "max_bytes": 1048576
      }
    },
    "device.speech-models": {
      "version": 1,
      "reason": "Tek nakon klika pripremiti i odabrati zajednički English model/glas na ovom uređaju.",
      "limits": {"max_bytes": 805306368, "max_asset_bytes": 268435456, "max_chunk_bytes": 8388608}
    },
    "media.microphone.capture": {
      "version": 1,
      "reason": "Na zahtjev snimiti vlastitu riječ do 4 sekunde; snimak ostaje lokalno.",
      "limits": {"max_duration_ms": 4000}
    },
    "media.speech": {
      "version": 1,
      "reason": "Namjerno izgovoriti English demo preko stvarnog Möbius Voice glasa odabranog na uređaju.",
      "limits": {
        "max_text_chars": 5000
      }
    }
  },
